# Cloud project defaults for the hybrid sample
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_API_KEY=

# Optional defaults used by the cloud hybrid tools
CLOUD_HYBRID_DEFAULT_PROJECT=your-project-id
CLOUD_HYBRID_DEFAULT_BUCKET=your-bucket-name
CLOUD_HYBRID_DEFAULT_DATASET=your_dataset

# Optional: restrict any local file reads to this directory
# ADK_CLOUD_HYBRID_SKILLS_PROJECT_ROOT=/path/to/your/repo
