# Vertex AI / model configuration.
GOOGLE_CLOUD_PROJECT=ark-of-data-2000
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_API_KEY=

# Optional override. If unset, the agent computes the repo root automatically.
# ADK_SKILLS_PROJECT_ROOT=/Users/wayne/Repo/github/agentic/adk-python

# Skill script execution defaults to disabled.
# Valid values:
#   disabled
#   unsafe-local
#   container
#   gke
#   agent-engine-sandbox
ADK_SKILLS_CODE_EXECUTOR=disabled
ADK_SKILLS_SCRIPT_TIMEOUT=60

# Unsafe local execution:
# ADK_SKILLS_CODE_EXECUTOR=unsafe-local

# Container execution:
# ADK_SKILLS_CODE_EXECUTOR=container
# ADK_SKILLS_CONTAINER_IMAGE=python:3.11-slim
# ADK_SKILLS_CONTAINER_DOCKER_PATH=/usr/local/bin/docker
# ADK_SKILLS_CONTAINER_BASE_URL=unix:///var/run/docker.sock

# GKE execution:
# ADK_SKILLS_CODE_EXECUTOR=gke
# ADK_SKILLS_GKE_NAMESPACE=default
# ADK_SKILLS_GKE_IMAGE=python:3.11-slim
# ADK_SKILLS_GKE_TIMEOUT_SECONDS=300
# ADK_SKILLS_GKE_EXECUTOR_TYPE=job
# ADK_SKILLS_GKE_KUBECONFIG_PATH=/Users/wayne/.kube/config
# ADK_SKILLS_GKE_KUBECONFIG_CONTEXT=my-gke-context

# Agent Engine sandbox execution:
# ADK_SKILLS_CODE_EXECUTOR=agent-engine-sandbox
# ADK_SKILLS_AGENT_ENGINE_RESOURCE_NAME=projects/ark-of-data-2000/locations/us-central1/reasoningEngines/1234567890123456789
# ADK_SKILLS_SANDBOX_RESOURCE_NAME=projects/ark-of-data-2000/locations/us-central1/reasoningEngines/1234567890123456789/sandboxEnvironments/9876543210987654321
